# Copy to .env and fill in. .env is gitignored and must never be committed.

# Scoring and annotation (vision_score.py, annotate_inputs.py, and the
# read-back step of generate_openai_documents.py).
ANTHROPIC_API_KEY=sk-ant-...

# Optional, generate_openai_documents.py only: photoreal document rendering.
OPENAI_API_KEY=sk-...

# Optional, benchmark dataset downloads.
ROBOFLOW_API_KEY=...
